# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value here has a working default or a documented "not set" behaviour,
# so the app boots and Steps 1-3 are fully testable with none of them filled in.

# --- Database -------------------------------------------------------------
# Postgres in production; SQLite is fine for local development. The schema
# depends on nothing SQLite-specific, so this is the only line that changes.
DATABASE_URL=sqlite:///./wanas.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/wanas

# --- LLM provider ---------------------------------------------------------
# "gemini" for the real thing, "fake" for the scripted provider used by the
# tests and by the harness when no key exists yet.
LLM_PROVIDER=fake

# GEMINI_API_KEY / GEMINI_MODEL are accepted as aliases for these two.
# No format check is applied to the key: newer Google keys look like
# "AQ.Ab..." rather than "AIzaSy...", and anything that pattern-matches a
# prefix rejects a valid credential.
LLM_API_KEY=

# Leave blank to let the provider ask the key which models it can actually
# call and pick one (it logs which). Set a name to pin it -- a pinned name
# that later gets deprecated is retried once against the live list rather
# than failing. Avoid "-latest" aliases: they can resolve to a model whose
# free quota is effectively zero, which surfaces as a 429 that reads like a
# bug rather than a quota decision.
LLM_MODEL=

# Logs the exact request body sent to the provider, right before the call.
# INVALID_ARGUMENT rarely says which field was wrong, and this is the
# difference between reading the answer and guessing at it. Off by default;
# noisy, and it prints whole conversations. The API key is never in the body.
LLM_DEBUG_PAYLOAD=0

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# Until these are set the WhatsApp adapter stays inert: the webhook returns
# 503, and outbound notifications are logged instead of sent. Nothing else
# in the system changes.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Shopify (Admin API) --------------------------------------------------
# Custom app token from: Settings > Apps and sales channels > Develop apps.
# Shown once at install time. Scopes needed: read/write_products,
# read/write_inventory, read_locations, write_themes, read_orders.
# This token can change live prices and inventory -- treat it as a password.
# Never commit it: .env is git-ignored, this example file is not.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# --- Agent behaviour (decided in AGENTS.md; here so they are tunable) ------
HISTORY_CAP=40
SESSION_EXPIRY_HOURS=6
TOOL_LOOP_CAP=8
MAX_QUANTITY_PER_LINE=10

# Surfaces real error text in the customer's reply. Invaluable while building,
# and it must default to off.
CHATBOT_DEBUG=0

# The local chat UI at /harness. Unauthenticated by design -- anyone who can
# reach it can converse as any customer identity. Set to 0 for any deployment
# that is reachable by someone other than you.
HARNESS_ENABLED=1
