# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value here has a working default or a documented "not set" behaviour,
# so the app boots and Steps 1-3 are fully testable with none of them filled in.

# --- Database -------------------------------------------------------------
# PostgreSQL is the documented default and the only durable option in a
# deployment. SQLite is LOCAL DEVELOPMENT ONLY: on Railway the container
# filesystem is wiped on every redeploy, so a SQLite database there loses
# every session, client and order each deploy -- while the startup seed
# refills catalog and shipping fees, so the shop still looks alive. The app
# refuses to boot on SQLite in a deployed environment; if you genuinely mean
# it, set ALLOW_SQLITE_IN_DEPLOY=1 (a WARNING logs either way). Placeholders
# only below -- never put real credentials in this file.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/wanas
# Local development alternative (its file is disposable by design):
# DATABASE_URL=sqlite:///./wanas.db

# --- LLM provider ---------------------------------------------------------
# The conversation model runs through OpenRouter by default: "openrouter" is
# the recommended primary and what LLM_PROVIDER falls back to when unset.
# "gemini" remains a fully supported alternate, and "fake" selects the
# scripted provider used by the tests and by the harness when no key exists
# yet.
LLM_PROVIDER=openrouter

# Key for everything the OpenRouter provider does -- chat replies, voice-note
# transcription and photo reading all run on one model through OpenRouter.
# Deliberately NOT shared with the Gemini settings below: a routed-inference
# key sent to a different vendor (or vice versa) only surfaces later as an
# auth failure far from its cause. Replace this placeholder with the real key
# -- until then the first message will fail rather than fall back cleanly.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- Gemini (alternate provider) -------------------------------------------
# Set LLM_PROVIDER=gemini to make Google the conversation model AND the voice
# note / photo reader (Gemini handles all three itself on the same key; the
# single-model OpenRouter wiring above is not used in that mode).
# GEMINI_API_KEY / GEMINI_MODEL are accepted as aliases for the two settings
# below. No format check is applied to the key: newer Google keys look like
# "AQ.Ab..." rather than "AIzaSy...", and anything that pattern-matches a
# prefix rejects a valid credential.
LLM_API_KEY=
GEMINI_API_KEY=

# Blank lets the active provider pick: Gemini asks the key which models it can
# actually call and picks one (it logs which); OpenRouter uses its own pinned
# default model (google/gemini-3.1-flash-lite) for chat, voice notes and
# photos alike. Set a name to pin it -- under Gemini a pinned name that later
# gets deprecated is retried once against the live list rather than failing;
# avoid "-latest" aliases: they can resolve to a model whose free quota is
# effectively zero, which surfaces as a 429 that reads like a bug rather than
# a quota decision.
LLM_MODEL=
GEMINI_MODEL=

# Optional second model, used only by the direct-Gemini provider for reading
# photos (blank lets Gemini pick its own default). Under the default
# LLM_PROVIDER=openrouter it does nothing: chat, voice notes and photos all
# run on the one LLM_MODEL/DEFAULT_MODEL above.
LLM_MEDIA_MODEL=

# Logs the exact request body sent to the provider, right before the call.
# INVALID_ARGUMENT rarely says which field was wrong, and this is the
# difference between reading the answer and guessing at it. Off by default;
# noisy, and it prints whole conversations. The API key is never in the body.
LLM_DEBUG_PAYLOAD=0

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# Until these are set the WhatsApp adapter stays inert: the webhook returns
# 503, and outbound notifications are logged instead of sent. Nothing else
# in the system changes.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Instagram (Meta Instagram Login API) ---------------------------------
# Until these are set the Instagram adapter stays inert: the webhook returns
# 503 and outbound messages are logged instead of sent -- same contract as
# WhatsApp above. Commented out entirely because nothing consumes them until
# the channel ships; uncomment and fill in at launch (docs/OPERATIONS.md has
# the full checklist).
# INSTAGRAM_ACCOUNT_ID is the numeric IG professional-account ID, NOT the
# @handle. INSTAGRAM_USERNAME is only ever used in customer-facing copy.
#
# WARNING: INSTAGRAM_APP_SECRET is NOT the same value as WHATSAPP_APP_SECRET,
# even inside the same Meta app -- with Instagram Login the webhook signature
# is computed with the Instagram product's own app secret. They are different
# strings on purpose; do not "simplify" one away.
#
# TOKEN EXPIRY: an Instagram long-lived access token expires after **60 days**
# and there is no refresh-token flow like OAuth's -- the token refreshes itself
# through graph.instagram.com/refresh_access_token while it is still valid.
# If that refresh is not automated, the channel dies silently 60 days after
# launch with no symptom but 190-series auth errors. See docs/OPERATIONS.md
# before launch.
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_API_VERSION=v23.0
# INSTAGRAM_USERNAME=
# Comments are a public surface: every reply under a post is visible to anyone
# who scrolls past it, so they ship OFF and are turned on deliberately, per
# post, after the DM half has been watched for a few days.
# INSTAGRAM_COMMENTS_ENABLED=0
# Whether the bot writes a visible reply under the comment at all, or only
# continues privately in DM.
# INSTAGRAM_PUBLIC_REPLY_ENABLED=1
# A comment older than this is ignored (Meta's private-reply window is 7 days;
# replying to a month-old post is noise, not service).
# INSTAGRAM_COMMENT_MAX_AGE_HOURS=48
# Per-commenter cap inside a rolling hour, so one person spamming a post
# cannot cost dozens of model calls.
# INSTAGRAM_COMMENT_RATE_LIMIT=3
# Signs the public media URLs Meta fetches attachments from. Falls back to
# DASHBOARD_SESSION_SECRET so one less secret has to be set.
# MEDIA_URL_SECRET=

# --- Shopify (Admin API) --------------------------------------------------
# Custom app token from: Settings > Apps and sales channels > Develop apps.
# Shown once at install time. Scopes needed: read/write_products,
# read/write_inventory, read_locations, write_themes, read_orders.
# This token can change live prices and inventory -- treat it as a password.
# Never commit it: .env is git-ignored, this example file is not.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# The app's webhook signing secret (Shopify calls it the API secret key).
# Without it POST /webhooks/shopify refuses every delivery -- an unauthenticated
# way to cancel orders is worse than no integration -- and nothing ever tells
# this side that an order shipped, so status pushes never fire.
# SHOPIFY_API_SECRET is accepted as an alias.
SHOPIFY_WEBHOOK_SECRET=

# Where this app is reachable from the internet -- used only to register the
# Shopify webhook subscriptions above against the right callback URL. Leave
# unset on Railway: RAILWAY_PUBLIC_DOMAIN is already injected automatically
# and used as a fallback. Set explicitly only off Railway, or to override it.
# PUBLIC_BASE_URL=https://your-app.example.com

# --- Agent behaviour (decided in AGENTS.md; here so they are tunable) ------
HISTORY_CAP=40
# How many messages one conversation's stored transcript keeps behind the live
# context. Nothing else in the app deletes a message; this is the only bound.
SESSION_ARCHIVE_CAP=2000
SESSION_EXPIRY_HOURS=6
TOOL_LOOP_CAP=8
MAX_QUANTITY_PER_LINE=10

# --- Inbound message handling --------------------------------------------
# How long a message waits for the customer's next one before the agent runs.
# WhatsApp is typed in fragments: "عايز هودي" / "أسود" / "لارج" inside five
# seconds is one request, and answering it three times costs three model calls
# and reads like three different people replying. 0 processes each message on
# arrival, in the request thread -- what the test suite uses, never production.
MESSAGE_DEBOUNCE_SECONDS=6
# Threads running agent turns. One conversation is always answered serially;
# this caps how many *different* conversations run at once.
MESSAGE_WORKERS=8

# --- Voice notes and photos ----------------------------------------------
# Both fall back to a human handoff whenever they are off, unsupported by the
# provider, or unreadable -- which is exactly what happened to every one of
# them before this existed.
VOICE_NOTES_ENABLED=1
IMAGE_UNDERSTANDING_ENABLED=1
# How sure the vision pass has to be before a photo is treated as "this
# product". Below it the reading is only used to ask a better question, never
# to claim the shop has something.
IMAGE_MATCH_CONFIDENCE=0.6

# Tappable list messages for the governorate picker. Off falls back to asking
# in prose, which is what the bot did before.
INTERACTIVE_MESSAGES_ENABLED=1

# At startup, add columns the models declare and an existing table lacks.
# `create_all` only ever adds whole tables, so with this off a database that
# predates a model change keeps its old shape until the first write that needs
# the new column fails. Additive only -- it never drops or retypes anything.
AUTO_MIGRATE_SCHEMA=1

# Surfaces real error text in the customer's reply. Invaluable while building,
# and it must default to off.
CHATBOT_DEBUG=0

# The local chat UI at /harness. Unauthenticated by design -- anyone who can
# reach it can converse as any customer identity, so it ships **off** and this
# line is how a developer turns it on locally. Never set it in a deployment
# anyone else can reach.
HARNESS_ENABLED=1

# --- Staff dashboard -------------------------------------------------------
# /dashboard: see who is waiting on a handoff and reply. Unlike the harness
# above it requires a staff login (python -m backend.cli create-staff) and
# stays ON by default -- but with no secret set here, login refuses outright
# (503) rather than signing session cookies with a secret that changes every
# restart. Set this to a long random string before the first deploy, or a
# paused conversation has no way back to the customer.
DASHBOARD_SESSION_SECRET=
# How long a login stays signed in.
DASHBOARD_SESSION_HOURS=12
DASHBOARD_ENABLED=1

# --- Re-engagement (back-in-stock, abandoned carts) -----------------------
# How often the background job checks for a restocked waitlisted variant and
# for carts gone idle. <= 0 disables the loop.
REENGAGEMENT_INTERVAL_SECONDS=1800
# How long a cart sits untouched before the "still interested?" nudge.
ABANDONED_CART_HOURS=2
# Past this age a cart is dead rather than abandoned -- an ancient test cart
# must not get nudged on every restart forever.
ABANDONED_CART_MAX_AGE_HOURS=48
# Approved Meta template names for the two proactive messages above, used
# only once the customer's last message is more than 24 hours old (Meta
# refuses free-form business-initiated text outside that window). Blank
# until each is actually submitted and approved -- see docs/OPERATIONS.md.
# With no template configured, a message that falls outside the window queues
# a staff alert instead of going out automatically.
WHATSAPP_TEMPLATE_BACK_IN_STOCK=
WHATSAPP_TEMPLATE_ABANDONED_CART=
WHATSAPP_TEMPLATE_LANGUAGE=ar
