# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value here has a working default or a documented "not set" behaviour,
# so the app boots and Steps 1-3 are fully testable with none of them filled in.

# --- Database -------------------------------------------------------------
# PostgreSQL is the documented default and the only durable option in a
# deployment. SQLite is LOCAL DEVELOPMENT ONLY: on Railway the container
# filesystem is wiped on every redeploy, so a SQLite database there loses
# every session, client and order each deploy -- while the startup seed
# refills catalog and shipping fees, so the shop still looks alive. The app
# refuses to boot on SQLite in a deployed environment; if you genuinely mean
# it, set ALLOW_SQLITE_IN_DEPLOY=1 (a WARNING logs either way). Placeholders
# only below -- never put real credentials in this file.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/wanas
# Local development alternative (its file is disposable by design):
# DATABASE_URL=sqlite:///./wanas.db

# --- LLM provider ---------------------------------------------------------
# The conversation model runs through OpenRouter by default: "openrouter" is
# the recommended primary and what LLM_PROVIDER falls back to when unset.
# "gemini" remains a fully supported alternate, and "fake" selects the
# scripted provider used by the tests and by the harness when no key exists
# yet.
LLM_PROVIDER=openrouter

# Key for everything the OpenRouter provider does -- chat replies, voice-note
# transcription and photo reading all go through OpenRouter on this one key
# (on two model ids: see LLM_MODEL and LLM_MEDIA_MODEL below).
# Deliberately NOT shared with the Gemini settings below: a routed-inference
# key sent to a different vendor (or vice versa) only surfaces later as an
# auth failure far from its cause. Replace this placeholder with the real key
# -- until then the first message will fail rather than fall back cleanly.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- Gemini (alternate provider) -------------------------------------------
# Set LLM_PROVIDER=gemini to make Google the conversation model AND the voice
# note / photo reader (Gemini handles all three itself on the same key; the
# single-model OpenRouter wiring above is not used in that mode).
# GEMINI_API_KEY / GEMINI_MODEL are accepted as aliases for the two settings
# below. No format check is applied to the key: newer Google keys look like
# "AQ.Ab..." rather than "AIzaSy...", and anything that pattern-matches a
# prefix rejects a valid credential.
LLM_API_KEY=
GEMINI_API_KEY=

# Blank lets the active provider pick: Gemini asks the key which models it can
# actually call and picks one (it logs which); OpenRouter uses its own pinned
# default conversation model (z-ai/glm-5.3-flash) -- chosen because it does
# not invent catalogue facts and acts on the tool results it is handed. Voice
# notes and photos do NOT run on it; see LLM_MEDIA_MODEL below. Set a name to
# pin it -- under Gemini a pinned name that later
# gets deprecated is retried once against the live list rather than failing;
# avoid "-latest" aliases: they can resolve to a model whose free quota is
# effectively zero, which surfaces as a 429 that reads like a bug rather than
# a quota decision.
LLM_MODEL=
GEMINI_MODEL=

# The model that reads voice notes and photos. Under LLM_PROVIDER=openrouter
# this is a real split and blank does NOT mean "same as chat": it falls back
# to DEFAULT_MEDIA_MODEL (google/gemini-3.1-flash-lite), because the default
# conversation model has no audio endpoint at all and OpenRouter answers "no
# endpoints found that support input audio" -- which turns every voice note
# into a handoff without saying why. Under LLM_PROVIDER=gemini this is the
# photo-reading model only, and blank lets Gemini pick its own default.
LLM_MEDIA_MODEL=google/gemini-3.1-flash-lite

# Which upstream providers OpenRouter may serve LLM_MODEL from, preferred
# first, and at which quantizations. OpenRouter hosts one model id on many
# providers (twenty-three for z-ai/glm-5.3-flash) and load-balances between
# them per request -- six identical requests were measured landing on three
# different ones.
#
# That matters because of what the default does with parameters: a provider
# that does not implement `temperature` is sent the request anyway and
# silently drops it, so a reply meant to be sampled at 0.3 is sampled at that
# stack's own default. Egyptian Arabic degrades first under that, and it
# degrades per request -- most replies fine, an occasional one grammatically
# broken or answering a question nobody asked. Pinning these makes the
# provider filter `require_parameters`, which is what turns temperature back
# into a setting rather than a suggestion.
#
# Fallbacks stay enabled: this excludes stacks that answer badly, it does not
# make one provider a single point of failure. Clear BOTH to restore
# OpenRouter's unfiltered default (not recommended in production).
OPENROUTER_PROVIDERS=z-ai,deepinfra,novita
# "unknown" is deliberately not in this list: an endpoint that will not say
# what precision it runs at is not one to put a customer's Arabic through.
OPENROUTER_QUANTIZATIONS=fp8,bf16,fp16

# Optional separate model for the Instagram comment classifier (the cheap
# JSON-only call that sorts a public comment into important/positive/negative/
# complaint/spam/neither). Blank reuses LLM_MODEL, which is today's behaviour
# bit for bit.
#
# Not a cost setting -- the call is ~250 tokens in and 20 out, and rounds to
# nothing. It is a decoupling one: without it, upgrading the chat model
# silently changes how a *live public surface* is classified, and a model
# being pulled or rate-limited takes chat and comments down together. Pin one
# here before touching LLM_MODEL if the comment surface is on.
COMMENT_CLASSIFIER_MODEL=

# Logs the exact request body sent to the provider, right before the call.
# INVALID_ARGUMENT rarely says which field was wrong, and this is the
# difference between reading the answer and guessing at it. Off by default;
# noisy, and it prints whole conversations. The API key is never in the body.
LLM_DEBUG_PAYLOAD=0

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# Until these are set the WhatsApp adapter stays inert: the webhook returns
# 503, and outbound notifications are logged instead of sent. Nothing else
# in the system changes.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Instagram (Meta Instagram Login API) ---------------------------------
# Until these are set the Instagram adapter stays inert: the webhook returns
# 503 and outbound messages are logged instead of sent -- same contract as
# WhatsApp above. Commented out entirely because nothing consumes them until
# the channel ships; uncomment and fill in at launch (docs/OPERATIONS.md has
# the full checklist).
# INSTAGRAM_ACCOUNT_ID is the numeric IG professional-account ID, NOT the
# @handle. INSTAGRAM_USERNAME is only ever used in customer-facing copy.
#
# WARNING: INSTAGRAM_APP_SECRET is NOT the same value as WHATSAPP_APP_SECRET,
# even inside the same Meta app -- with Instagram Login the webhook signature
# is computed with the Instagram product's own app secret. They are different
# strings on purpose; do not "simplify" one away.
#
# TOKEN EXPIRY: an Instagram long-lived access token expires after **60 days**
# and there is no refresh-token flow like OAuth's -- the token refreshes itself
# through graph.instagram.com/refresh_access_token while it is still valid.
# If that refresh is not automated, the channel dies silently 60 days after
# launch with no symptom but 190-series auth errors. See docs/OPERATIONS.md
# before launch.
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_API_VERSION=v23.0
# INSTAGRAM_USERNAME=
# The SAME account's app-scoped id, which is a different number from
# INSTAGRAM_ACCOUNT_ID above. Both come from one call:
#   GET graph.instagram.com/v23.0/me?fields=id,user_id&access_token=...
# `user_id` is INSTAGRAM_ACCOUNT_ID (addresses the Graph endpoints); `id` is
# this one. Which of the two Meta puts in `sender.id` on an echo, or `from.id`
# on the shop's own comment, is Meta's choice -- so both are registered as
# "us" and neither is ever answered. Optional, but leaving it blank on a live
# account is what the self-reply loop is made of.
# INSTAGRAM_APP_SCOPED_ID=
# Comments are a public surface: every reply under a post is visible to anyone
# who scrolls past it, so they ship OFF and are turned on deliberately, per
# post, after the DM half has been watched for a few days.
# INSTAGRAM_COMMENTS_ENABLED=0
# Whether the bot writes a visible reply under the comment at all, or only
# continues privately in DM.
# INSTAGRAM_PUBLIC_REPLY_ENABLED=1
# The mirror of the flag above, for the private half. 0 means every category
# answers in public only and nobody is cold-DMed -- the one to reach for if
# private replies ever draw a warning from Meta, without taking the whole
# comment surface down with them.
# INSTAGRAM_COMMENTS_DM_ENABLED=1
# A comment older than this is ignored (Meta's private-reply window is 7 days;
# replying to a month-old post is noise, not service).
# INSTAGRAM_COMMENT_MAX_AGE_HOURS=48
# Per-commenter cap inside a rolling hour, so one person spamming a post
# cannot cost dozens of model calls.
# INSTAGRAM_COMMENT_RATE_LIMIT=3
# Per-commenter cap inside a rolling hour for the *fixed FAQ answers* -- the
# public one-liners about shipping cost, delivery time and payment, which are
# a table lookup and never a model call. Counted separately from
# INSTAGRAM_COMMENT_RATE_LIMIT above on purpose: that cap exists to stop a
# flood of DMs, and an FAQ reply sends no DM and costs no model call, so it
# should not spend that budget -- but it is still visible under a post, so it
# is not unlimited either. Over the limit the comment is dropped quietly; it
# is a chatty commenter, not a flood.
# INSTAGRAM_FAQ_RATE_LIMIT=5
# Signs the public media URLs Meta fetches attachments from. Falls back to
# DASHBOARD_SESSION_SECRET so one less secret has to be set.
# MEDIA_URL_SECRET=

# --- Shopify (Admin API) --------------------------------------------------
# Custom app token from: Settings > Apps and sales channels > Develop apps.
# Shown once at install time. Scopes needed: read/write_products,
# read/write_inventory, read_locations, write_themes, read_orders.
# This token can change live prices and inventory -- treat it as a password.
# Never commit it: .env is git-ignored, this example file is not.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# Must be 2026-01 or later: that is where inventorySetQuantities started
# requiring changeFromQuantity and an @idempotent key, and stock writes are
# refused outright on anything older rather than run without the compare.
SHOPIFY_API_VERSION=2026-07

# The brand name stamped on every product the dashboard creates. Shopify
# would otherwise default it to the store's own name ("My Store"), which is
# not what the products already on the shelf say.
SHOPIFY_VENDOR=Wanas Gallery

# The app's webhook signing secret (Shopify calls it the API secret key).
# Without it POST /webhooks/shopify refuses every delivery -- an unauthenticated
# way to cancel orders is worse than no integration -- and nothing ever tells
# this side that an order shipped, so status pushes never fire.
# SHOPIFY_API_SECRET is accepted as an alias.
SHOPIFY_WEBHOOK_SECRET=

# Where this app is reachable from the internet -- used only to register the
# Shopify webhook subscriptions above against the right callback URL. Leave
# unset on Railway: RAILWAY_PUBLIC_DOMAIN is already injected automatically
# and used as a fallback. Set explicitly only off Railway, or to override it.
# PUBLIC_BASE_URL=https://your-app.example.com

# --- Agent behaviour (decided in AGENTS.md; here so they are tunable) ------
# How many messages stay in the live slice of a conversation. Counted in
# messages, not exchanges -- one customer question costs four to six once the
# tool calls and their results are counted, which is why 40 was only about
# seven exchanges of memory.
HISTORY_CAP=150
# What the model is actually sent (assistant/context.py): the last N messages
# verbatim, plus up to MODEL_CONTEXT_RECALL older ones compacted to just what
# was said, with the tool calls and catalog dumps underneath them dropped.
# Set MODEL_CONTEXT_RECALL=0 to send only the verbatim window.
MODEL_CONTEXT_MESSAGES=24
MODEL_CONTEXT_RECALL=60
# How many messages one conversation's stored transcript keeps behind the live
# context. Nothing else in the app deletes a message; this is the only bound.
SESSION_ARCHIVE_CAP=2000
SESSION_EXPIRY_HOURS=6
TOOL_LOOP_CAP=8
MAX_QUANTITY_PER_LINE=10

# --- Inbound message handling --------------------------------------------
# How long a message waits for the customer's next one before the agent runs.
# WhatsApp is typed in fragments: "عايز هودي" / "أسود" / "لارج" inside five
# seconds is one request, and answering it three times costs three model calls
# and reads like three different people replying. 0 processes each message on
# arrival, in the request thread -- what the test suite uses, never production.
MESSAGE_DEBOUNCE_SECONDS=6
# Threads running agent turns. One conversation is always answered serially;
# this caps how many *different* conversations run at once.
MESSAGE_WORKERS=8

# --- Voice notes and photos ----------------------------------------------
# Both fall back to a human handoff whenever they are off, unsupported by the
# provider, or unreadable -- which is exactly what happened to every one of
# them before this existed.
VOICE_NOTES_ENABLED=1
IMAGE_UNDERSTANDING_ENABLED=1
# How sure the vision pass has to be before a photo is treated as "this
# product". Below it the reading is only used to ask a better question, never
# to claim the shop has something.
IMAGE_MATCH_CONFIDENCE=0.6

# Tappable list messages for the governorate picker. Off falls back to asking
# in prose, which is what the bot did before.
INTERACTIVE_MESSAGES_ENABLED=1

# At startup, add columns the models declare and an existing table lacks.
# `create_all` only ever adds whole tables, so with this off a database that
# predates a model change keeps its old shape until the first write that needs
# the new column fails. Additive only -- it never drops or retypes anything.
AUTO_MIGRATE_SCHEMA=1

# At startup, log which wanas.db products Shopify no longer has -- the bot is
# still offering those, at whatever the stale local columns say. A report
# only: it never writes. Clearing them is
# `python scripts/shopify_reconcile_products.py --apply`, by hand, because a
# reconcile that deletes unattended is one bad Shopify read from an empty
# catalog.
RECONCILE_REPORT_ON_BOOT=1

# Surfaces real error text in the customer's reply. Invaluable while building,
# and it must default to off.
CHATBOT_DEBUG=0

# The local chat UI at /harness. Unauthenticated by design -- anyone who can
# reach it can converse as any customer identity, so it ships **off** and this
# line is how a developer turns it on locally. Never set it in a deployment
# anyone else can reach.
HARNESS_ENABLED=1

# --- Staff dashboard -------------------------------------------------------
# /dashboard: see who is waiting on a handoff and reply. Unlike the harness
# above it requires a staff login (python -m backend.cli create-staff) and
# stays ON by default -- but with no secret set here, login refuses outright
# (503) rather than signing session cookies with a secret that changes every
# restart. Set this to a long random string before the first deploy, or a
# paused conversation has no way back to the customer.
DASHBOARD_SESSION_SECRET=
# How long a login stays signed in.
DASHBOARD_SESSION_HOURS=12
DASHBOARD_ENABLED=1

# --- Re-engagement (back-in-stock, abandoned carts) -----------------------
# How often the background job checks for a restocked waitlisted variant and
# for carts gone idle. <= 0 disables the loop.
REENGAGEMENT_INTERVAL_SECONDS=1800
# How long a cart sits untouched before the "still interested?" nudge.
ABANDONED_CART_HOURS=2
# Past this age a cart is dead rather than abandoned -- an ancient test cart
# must not get nudged on every restart forever.
ABANDONED_CART_MAX_AGE_HOURS=48
# Approved Meta template names for the two proactive messages above, used
# only once the customer's last message is more than 24 hours old (Meta
# refuses free-form business-initiated text outside that window). Blank
# until each is actually submitted and approved -- see docs/OPERATIONS.md.
# With no template configured, a message that falls outside the window queues
# a staff alert instead of going out automatically.
WHATSAPP_TEMPLATE_BACK_IN_STOCK=
WHATSAPP_TEMPLATE_ABANDONED_CART=
# The same rule applies to everything that follows an order, and these are
# the ones it bites hardest: a customer orders today and the parcel ships
# tomorrow, so the status push and the post-delivery rating request are
# routinely outside the 24-hour window. ORDER_UPDATE covers every status
# change (packed / shipped / delivered / cancelled), FEEDBACK_REQUEST the
# rating ask, ORDER_CONFIRMATION the confirmation itself (which in practice
# always goes out seconds after the customer's own message). Blank until each
# one is actually approved in Meta Business Manager -- with none configured,
# a push that falls outside the window is NOT sent, is written into the
# transcript as undelivered, and raises a staff alert to follow up by hand.
# The client sends templates with no variables, so the approved copy has to
# stand on its own ("there's an update on your order, open the chat").
WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_FEEDBACK_REQUEST=
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# --- Owner alert emails ------------------------------------------------
# Where the shop's owner is told, by email, about the staff-queue items that
# cannot wait for someone to open the dashboard: a negative or complaining
# Instagram comment, the bot crashing or failing to deliver a reply, an order
# modified/cancelled or an item swap requested, stock running low, and every
# `request_human` handoff (which PAUSES that conversation until a person picks
# it up). One reason is deliberately left out and it is the loud one --
# `order_confirmed` fires on every sale, and an address carrying it is an
# address that gets filtered. See domain/services/alert_email.py.
#
# All of this is optional. With ALERT_EMAIL_TO or the SMTP credentials blank
# nothing is sent and every alert still reaches the dashboard queue exactly
# as before.
#
# TRANSPORT. There are two, and only one of them works in production:
#
#   Gmail API (GMAIL_* below)  -- HTTPS, port 443. What delivers from Railway.
#   SMTP      (ALERT_SMTP_*)   -- what a laptop and most other hosts have.
#
# Railway blocks every outbound SMTP port: 25, 465, 587 and 2525 all answer
# "Network is unreachable" from inside the container while plain HTTP connects
# instantly. It is a platform policy against spam, not a setting, so a Gmail
# App Password cannot deliver from the deploy however correct it is. The Gmail
# API sends as the same mailbox over 443 and costs nothing.
#
# The Gmail API wins whenever its three values are set; SMTP answers otherwise.
# `GET /health` reports which one is in play as `alert_email_transport`.
#
# To fill the three in, run `python scripts/gmail_authorise.py` on your own
# machine -- the setup steps are at the top of that file. One of them matters
# more than it looks: PUBLISH the OAuth consent screen. Left in "Testing",
# Google expires the refresh token after seven days and the alerts stop a week
# after they started.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# The SMTP half. Gmail here needs a 16-character App Password (Google Account
# -> Security -> 2-Step Verification -> App passwords), not an account
# password. Useful locally; blocked on Railway, per the note above. Treat it
# as a credential -- .env and Railway only, never committed or logged.
# Each of these also answers to a plain alias, for pasting straight out of a
# mail provider's instructions: STORE_OWNER_EMAIL, SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_PASS, SMTP_FROM. The ALERT_-prefixed name wins if both are
# set, and is the one to prefer -- it says which feature the variable belongs
# to, which matters in a Railway panel holding forty of them.
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
# Defaults to ALERT_SMTP_USERNAME; Gmail will not let you forge another one.
ALERT_EMAIL_FROM=
# How long the same reason about the same conversation stays quiet after one
# mail, and a hard ceiling per hour across everything -- a crash loop raises
# one queue item per event by design, and must not raise one email per event.
ALERT_EMAIL_COOLDOWN_SECONDS=900
ALERT_EMAIL_MAX_PER_HOUR=20
